<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Camera body dimensions -->
    <xacro:property name="camera_height" value="0.05" />
    <xacro:property name="camera_length" value="0.01" />
    <xacro:property name="camera_width" value="0.10" />

    <!-- Physical camera link -->
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
        </collision>

        <xacro:box_inertia
            m="0.1"
            l="${camera_length}"
            w="${camera_width}"
            h="${camera_height}"
            xyz="0 0 0"
            rpy="0 0 0" />
    </link>

    <!-- Mount camera on robot -->
    <joint name="base_camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_link" />
        <origin
            xyz="${(base_length + camera_length) / 2.0} 0 ${base_height / 2.0}"
            rpy="0 0 0" />
    </joint>


    <!-- RGB optical frame -->
    <link name="camera_rgb_optical_frame" />

    <joint name="camera_rgb_optical_joint" type="fixed">
        <parent link="camera_link" />
        <child link="camera_rgb_optical_frame" />
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>


    <!-- Depth optical frame -->
    <link name="camera_depth_optical_frame" />

    <joint name="camera_depth_optical_joint" type="fixed">
        <parent link="camera_link" />
        <child link="camera_depth_optical_frame" />
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>


    <!-- Gazebo Classic RGB camera -->
    <xacro:unless value="$(arg is_ignition)">
        <gazebo reference="camera_link">
            <material>Gazebo/Red</material>

            <sensor name="rgb_camera" type="camera">
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>15.0</update_rate>

                <camera name="rgb_camera">
                    <horizontal_fov>1.047</horizontal_fov>

                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>

                    <clip>
                        <near>0.1</near>
                        <far>20.0</far>
                    </clip>
                </camera>

                <plugin
                    name="rgb_camera_controller"
                    filename="libgazebo_ros_camera.so">

                    <ros>
                        <remapping>~/image_raw:=/rgb/image_raw</remapping>
                        <remapping>~/camera_info:=/rgb/camera_info</remapping>
                    </ros>

                    <camera_name>rgb</camera_name>
                    <frame_name>camera_rgb_optical_frame</frame_name>

                </plugin>
            </sensor>


            <!-- Depth camera -->
            <sensor name="depth_camera" type="depth">
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>15.0</update_rate>

                <camera name="depth_camera">
                    <horizontal_fov>1.047</horizontal_fov>

                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>

                    <clip>
                        <near>0.1</near>
                        <far>20.0</far>
                    </clip>
                </camera>

                <plugin
                    name="depth_camera_controller"
                    filename="libgazebo_ros_camera.so">

                    <ros>
                        <remapping>~/image_depth:=/depth/image_raw</remapping>
                        <remapping>~/camera_info_depth:=/depth/camera_info</remapping>
                    </ros>

                    <camera_name>depth</camera_name>
                    <frame_name>camera_depth_optical_frame</frame_name>

                    <min_depth>0.1</min_depth>
                    <max_depth>20.0</max_depth>

                </plugin>
            </sensor>

        </gazebo>
    </xacro:unless>

</robot>