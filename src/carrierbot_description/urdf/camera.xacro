<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Camera body dimensions -->
    <xacro:property name="camera_height" value="0.05" />
    <xacro:property name="camera_length" value="0.01" />
    <xacro:property name="camera_width" value="0.10" />
    <!-- Lens center height from the floor: robot top 1.57 m, camera just below it. -->
    <xacro:property name="camera_mount_height" value="1.54" />
    <!-- Forward offset from base_link (estimate) and pitch (negative = looking up).
         Pitch measured level with a phone on top of the camera; the horizon in
         the B1 camera images agrees. -->
    <xacro:property name="camera_mount_x" value="0.10" />
    <xacro:property name="camera_mount_pitch" value="0.0" />

    <!-- Simulated RGB-D matched to the real ZED 2 pipeline (zed_usb2_rgbd.py):
         VGA 672x376, depth limited to 0.3-3.0 m (max_depth in zed_usb2_rgbd.launch.py).
         HFOV = 2*atan(336/fx). fx ~ 264 px is the usual ZED 2 VGA value; confirm with the
         "rectified fx" line that zed_usb2_rgbd prints at startup on the robot. -->
    <xacro:property name="camera_hfov" value="1.81" />
    <xacro:property name="camera_image_width" value="672" />
    <xacro:property name="camera_image_height" value="376" />
    <xacro:property name="camera_min_depth" value="0.3" />
    <xacro:property name="camera_max_depth" value="3.0" />

    <!-- Physical camera link -->
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
        </collision>

        <xacro:box_inertia
            m="0.1"
            l="${camera_length}"
            w="${camera_width}"
            h="${camera_height}"
            xyz="0 0 0"
            rpy="0 0 0" />
    </link>

    <!-- Mount the camera above the front display, facing forward. -->
    <joint name="base_camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_link" />
        <origin
            xyz="${camera_mount_x} 0 ${camera_mount_height - wheel_radius}"
            rpy="0 ${camera_mount_pitch} 0" />
    </joint>


    <!-- RGB optical frame -->
    <link name="camera_rgb_optical_frame" />

    <joint name="camera_rgb_optical_joint" type="fixed">
        <parent link="camera_link" />
        <child link="camera_rgb_optical_frame" />
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>


    <!-- Depth optical frame -->
    <link name="camera_depth_optical_frame" />

    <joint name="camera_depth_optical_joint" type="fixed">
        <parent link="camera_link" />
        <child link="camera_depth_optical_frame" />
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>


    <!-- Gazebo Classic RGB camera -->
    <xacro:unless value="$(arg is_ignition)">
        <gazebo reference="camera_link">
            <material>Gazebo/Red</material>

            <sensor name="rgbd_camera" type="depth">
                <always_on>true</always_on>
                <visualize>false</visualize>
                <update_rate>15.0</update_rate>

                <camera name="rgbd_camera">
                    <horizontal_fov>${camera_hfov}</horizontal_fov>

                    <image>
                        <width>${camera_image_width}</width>
                        <height>${camera_image_height}</height>
                        <format>R8G8B8</format>
                    </image>

                    <clip>
                        <near>0.1</near>
                        <far>20.0</far>
                    </clip>
                </camera>

                <plugin
                    name="rgbd_camera_controller"
                    filename="libgazebo_ros_camera.so">

                    <ros>
                        <!-- GazeboRosCamera resolves these from camera_name, not
                             from the plugin's private (~) namespace. -->
                        <remapping>rgbd/image_raw:=/rgb/image_raw</remapping>
                        <remapping>rgbd/camera_info:=/rgb/camera_info</remapping>
                        <remapping>rgbd/depth/image_raw:=/depth/image_raw</remapping>
                        <remapping>rgbd/depth/camera_info:=/depth/camera_info</remapping>
                    </ros>

                    <camera_name>rgbd</camera_name>
                    <frame_name>camera_rgb_optical_frame</frame_name>
                    <min_depth>${camera_min_depth}</min_depth>
                    <max_depth>${camera_max_depth}</max_depth>
                </plugin>
            </sensor>

        </gazebo>
    </xacro:unless>

</robot>
