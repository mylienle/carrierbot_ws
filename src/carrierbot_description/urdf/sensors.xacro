<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="lidar_height" value="0.037" />
    <xacro:property name="lidar_radius" value="0.0345" />

    <!-- Include lidar -->
    <link name="laser">
        <visual>
            <geometry>
                <cylinder radius="${lidar_height}" length="${lidar_radius}" />
            </geometry>
            <origin xyz="0 0 ${lidar_height/2 - 0.026}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_height}" length="${lidar_radius}" />
            </geometry>
            <origin xyz="0 0 ${lidar_height/4}" rpy="0 0 0" />
            <material name="grey" />
        </collision>
    </link>

    <!-- Include IMU -->
    <link name="imu">
        <visual>
            <geometry>
                <box size="0.05 0.05 0.01" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.05 0.01" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </collision>
    </link>

    <!-- v1 static TF (from robot_fablab amcl_localization.launch), expressed in base_link:
         footprint->laser: (-0.17, 0, 0.6, yaw=pi)
         footprint->imu:   (-0.17, 0.06, 0.6)
         base_link is wheel_radius above footprint -->
    <joint name="laser_joint" type="fixed">
        <parent link="base_link" />
        <child link="laser" />
        <origin xyz="-0.17 0 ${0.6 - wheel_radius}" rpy="0 0 ${pi}" />
    </joint>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu" />
        <origin xyz="-0.17 0.06 ${0.6 - wheel_radius}" rpy="0 0 0" />
    </joint>

    <!-- Gazebo Classic IMU. Publishes sensor_msgs/Imu on /imu/data. -->
    <xacro:unless value="$(arg is_ignition)">
        <gazebo reference="imu">
            <sensor name="imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>100.0</update_rate>
                <visualize>false</visualize>
                <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                    <ros>
                        <remapping>~/out:=imu/data</remapping>
                    </ros>
                    <frame_name>imu</frame_name>
                    <initial_orientation_as_reference>false</initial_orientation_as_reference>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:unless>

    <!-- Gazebo Sim sensor. ros_gz_bridge exposes /scan to ROS 2. -->
    <xacro:if value="$(arg is_ignition)">
        <gazebo reference="laser">
            <sensor name="laser" type="gpu_lidar">
                <pose>0 0 0 0 0 0</pose>
                <topic>/scan</topic>
                <visualize>true</visualize>
                <update_rate>10.0</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>720</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14</min_angle>
                            <max_angle>3.14</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.5</min>
                        <max>18.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </ray>
                <always_on>true</always_on>
            </sensor>
        </gazebo>
    </xacro:if>

    <!-- Gazebo Classic fallback. -->
    <xacro:unless value="$(arg is_ignition)">
        <gazebo reference="laser">
            <sensor name="laser" type="ray">
                <pose>0 0 0 0 0 0</pose>
                <visualize>true</visualize>
                <update_rate>10.0</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                        <samples>720</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14</min_angle>
                            <max_angle>3.14</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.5</min>
                        <max>18.0</max>
                        <resolution>1</resolution>
                    </range>
                </ray>
                <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <argument>~/out:=scan</argument>
                    </ros>
                    <output_type>sensor_msgs/LaserScan</output_type>
                    <frame_name>laser</frame_name>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:unless>

</robot>
